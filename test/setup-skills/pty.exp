#!/usr/bin/expect -f
# setup-skills.sh 的 PTY 交互验证：只在容器内执行，只覆盖核心交互路径。
# 用 HOME 隔离：零参数才进交互模式，不能传 --target。
set timeout 20
set shell [lindex $argv 0]
set pass 0
set fail 0

proc ok {m} { global pass; incr pass; puts "  \[ok\]   $m" }
proc bad {m} { global fail; incr fail; puts "  \[FAIL\] $m" }

# 共享库里没有 Skill 时软链阶段无事可做，不会出现确认提示，断言会因此误报。
set skills_root [exec jq -r {.shared.skills_root.user // ""} /workspace/config/agents.json]
if {$skills_root eq "" || [catch {exec sh -c "ls \"$env(HOME)/$skills_root\"/*/SKILL.md"}]} {
  puts "前提不满足：\$HOME 的共享库中没有 Skill"; exit 1
}

# --- 范围菜单 + 仓库地址输入 + 取消 ---
spawn $shell /workspace/setup-skills.sh
expect {
  timeout { bad "未出现范围菜单"; exit 1 }
  "选择安装范围" { ok "出现范围菜单" }
}
send "\r"
expect {
  timeout { bad "未询问仓库地址" }
  "来源仓库地址" { ok "询问仓库地址" }
}
send "\r"
expect {
  timeout { bad "未进入软链阶段" }
  "\[软链\]" { ok "留空仓库地址时只做软链" }
}
expect {
  timeout { bad "未出现确认提示" }
  "是否继续？" { ok "出现阶段确认提示" }
}
send "n\r"
expect eof

puts "\nPTY 通过 $pass，失败 $fail"
exit [expr {$fail == 0 ? 0 : 1}]
